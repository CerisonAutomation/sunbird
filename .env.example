# Multiplayer race server (Cloudflare Workers backend in backend/).
#
# Local dev: `npx wrangler dev` in backend/ (listens on :8787), then use the
# built-in vite proxy — the client connects same-origin, no CORS, works
# through any tunnel/preview host:
VITE_MULTIPLAYER_URL=/mp
#
# Production: point at the deployed Worker instead:
# VITE_MULTIPLAYER_URL=wss://sunbird-mp.<account>.workers.dev

# Global leaderboard — same Worker, same proxy in dev:
VITE_LEADERBOARD_URL=/mp
# Production: VITE_LEADERBOARD_URL=https://sunbird-mp.<account>.workers.dev
