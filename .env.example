# Sunbird — Stripe configuration
#
# Sunbird ships with a real, production-path Stripe integration built on
# Stripe Payment Links (the officially recommended client-only checkout
# method now that stripe.redirectToCheckout has been removed). No backend
# is required to accept real payments:
#
#   1. In the Stripe Dashboard, create two Payment Links:
#        - "Sunbird Gold" as a one-time payment
#        - "Sunbird VIP" as a monthly subscription
#   2. Set each Payment Link's "After payment" confirmation page to redirect
#      to this app's URL with a marker query param, e.g.:
#        https://yourgame.example.com/?sunbird_stripe=gold
#        https://yourgame.example.com/?sunbird_stripe=vip
#      Sunbird detects this on load and grants the entitlement automatically.
#   3. Paste the Payment Link URLs and your publishable key below and
#      redeploy. Until these are set, Sunbird automatically runs its
#      polished sandbox "Demo Checkout" so the store is always fully
#      testable end-to-end.
#
# For real fulfillment security, pair this with a Stripe webhook
# (checkout.session.completed) that emails a license/redeem code — the
# in-app "Redeem code" box already accepts arbitrary promo codes, so a
# webhook-driven fulfillment flow can plug straight in.

VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_GOLD_LINK=
VITE_STRIPE_VIP_LINK=

# Online multiplayer WebSocket server (run `npx tsx server/index.ts`)
# Leave empty to disable the multiplayer screen
VITE_MULTIPLAYER_WS_URL=

# Global leaderboard REST endpoint — POST /scores, GET /scores?limit=N
# Leave empty to use device-local leaderboard only
VITE_GLOBAL_LB_ENDPOINT=

# Web Push VAPID public key for re-engagement notifications
# Generate a keypair with: npx web-push generate-vapid-keys
# Leave empty to disable push notification prompts
VITE_VAPID_PUBLIC_KEY=
